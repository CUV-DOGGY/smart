# LLM
MODEL_NAME=your-model-name
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.example.com

# MongoDB / Redis
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_customer_service
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# 高德地图 Web 服务
AMAP_WEB_SERVICE_KEY=replace-with-your-amap-web-service-key
AMAP_CONNECT_TIMEOUT_SECONDS=2
AMAP_READ_TIMEOUT_SECONDS=3
AMAP_MAX_RETRIES=1
AMAP_GEOCODE_CACHE_SECONDS=86400
ORDER_GEOCODE_RATE_LIMIT_BY_USER=30
ORDER_GEOCODE_RATE_LIMIT_WINDOW_SECONDS=300

# JWT: 生产环境请使用密码学安全的随机值，不要使用下面的占位符。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=smart-customer-service
JWT_AUDIENCE=smart-customer-service-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 认证限流
LOGIN_RATE_LIMIT_GLOBAL=100
LOGIN_RATE_LIMIT_BY_IP=30
LOGIN_RATE_LIMIT_BY_USERNAME=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_BY_IP=10
REGISTER_RATE_LIMIT_BY_USERNAME=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_KEY_SECRET=replace-with-a-different-32-character-secret

# Argon2：此并发数是每个 Python worker 的上限。
PASSWORD_HASH_MAX_CONCURRENCY=5
PASSWORD_HASH_WAIT_TIMEOUT_SECONDS=2

# HTTP / 代理。list 类型环境变量使用 JSON 数组。
AUTH_MAX_REQUEST_BODY_BYTES=16384
TRUSTED_PROXY_CIDRS=[]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
